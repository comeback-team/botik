<section id="s{{ idx }}" class="py-14 md:py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display text-2xl md:text-4xl font-bold mb-8">{{ block.title }}</h2>
    <div class="grid lg:grid-cols-2 gap-6">
      <div class="card bg-base-200">
        <div class="card-body gap-4 text-base">
          {% if block.phone %}<p class="flex gap-3 items-center"><span class="text-primary text-xl">📞</span><a href="tel:{{ block.phone }}" class="link link-hover font-medium">{{ block.phone }}</a></p>{% endif %}
          {% if block.email %}<p class="flex gap-3 items-center"><span class="text-primary text-xl">✉️</span><a href="mailto:{{ block.email }}" class="link link-hover font-medium">{{ block.email }}</a></p>{% endif %}
          {% if block.address %}<p class="flex gap-3 items-start"><span class="text-primary text-xl">📍</span><span>{{ block.address }}</span></p>{% endif %}
        </div>
      </div>
      <div class="card bg-base-200">
        <div class="card-body gap-4">
          {% if block.hours %}<div><p class="font-semibold mb-1 flex gap-2 items-center"><span class="text-primary text-xl">🕒</span>Часы работы</p><p class="text-sm opacity-80 whitespace-pre-line">{{ block.hours }}</p></div>{% endif %}
          {% if block.address %}<a href="https://yandex.ru/maps/?text={{ block.address | urlencode }}" target="_blank" rel="noopener" class="btn btn-outline btn-block mt-auto">Построить маршрут</a>{% endif %}
        </div>
      </div>
    </div>
  </div>
</section>