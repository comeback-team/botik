<section id="s{{ idx }}" class="py-14 md:py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl md:text-4xl font-bold text-center mb-10 [overflow-wrap:anywhere]">{{ block.title }}</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
      {% for item in block.items %}
      <div class="card bg-base-100 shadow-md overflow-hidden">
        <figure><img src="https://picsum.photos/seed/{{ item.caption | urlencode }}/600/400" alt="{{ item.alt or item.caption }}" loading="lazy" class="w-full h-32 md:h-44 object-cover"></figure>
        <div class="card-body p-3"><p class="text-xs md:text-sm font-medium [overflow-wrap:anywhere]">{{ item.caption }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>