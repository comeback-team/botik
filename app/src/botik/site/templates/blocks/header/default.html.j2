<div class="navbar bg-base-100/90 backdrop-blur sticky top-0 z-50 shadow-sm px-3 lg:px-8 gap-2">
  <div class="navbar-start min-w-0 flex-1 gap-1">
    <div class="dropdown shrink-0">
      <label tabindex="0" class="btn btn-ghost btn-square lg:hidden" aria-label="Открыть меню">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </label>
      <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[60] p-2 shadow bg-base-100 rounded-box w-52">
        {% for item in block.menu %}<li><a href="#s{{ loop.index }}">{{ item }}</a></li>{% endfor %}
      </ul>
    </div>
    <a href="#s0" title="{{ block.logo_text }}"
       class="btn btn-ghost normal-case text-primary h-auto min-h-0 py-1 px-2 text-left leading-tight whitespace-normal break-words text-base lg:text-xl max-w-full">{{ block.logo_text }}</a>
  </div>
  <div class="navbar-end hidden lg:flex shrink-0">
    <ul class="menu menu-horizontal px-1 flex-wrap">
      {% for item in block.menu %}<li><a href="#s{{ loop.index }}">{{ item }}</a></li>{% endfor %}
    </ul>
    <a href="{{ cta_anchor }}" class="btn btn-primary btn-sm ml-2 whitespace-normal h-auto py-2">{{ block.menu[-1] }}</a>
  </div>
</div>