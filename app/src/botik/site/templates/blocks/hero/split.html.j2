<section id="s{{ idx }}" class="bg-base-200">
  <div class="hero min-h-[60vh] max-w-6xl mx-auto">
    <div class="hero-content flex-col lg:flex-row-reverse gap-8 lg:gap-16 py-14 md:py-20 w-full max-w-full">
      {% if block.highlights %}
      <div class="stats stats-vertical sm:stats-horizontal shadow bg-base-100 w-full max-w-full">
        {% for h in block.highlights %}
        <div class="stat min-w-0">
          <div class="stat-value text-primary text-2xl">✦</div>
          <div class="stat-desc text-base [overflow-wrap:anywhere]">{{ h }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      <div class="max-w-xl min-w-0">
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight [overflow-wrap:anywhere]">{{ block.title }}</h1>
        {% if block.subtitle %}<p class="py-6 text-base md:text-lg opacity-80 [overflow-wrap:anywhere]">{{ block.subtitle }}</p>{% endif %}
        <a href="{{ cta_anchor }}" class="btn btn-primary btn-lg whitespace-normal h-auto py-3 max-w-full">{{ block.cta_text }}</a>
      </div>
    </div>
  </div>
</section>