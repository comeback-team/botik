<section id="s{{ idx }}" class="py-14 md:py-20 px-4 bg-base-200">
  <div class="max-w-3xl mx-auto card bg-base-100 shadow-xl">
    <div class="card-body gap-4" data-a2ui-block data-submit-action="{{ block.submit_action }}" data-currency="{{ block.currency }}">
      <div class="flex items-center justify-between gap-3">
        <h2 class="card-title font-display text-2xl md:text-3xl">{{ block.title }}</h2>
        <span class="badge badge-primary badge-lg gap-1">🛒 <span data-cart-count>0</span></span>
      </div>
      <ul class="divide-y divide-base-300">
        {% for item in block.items %}
        <li class="py-4 flex items-start justify-between gap-4">
          <div>
            <p class="font-semibold">{{ item.name }}</p>
            {% if item.description %}<p class="text-sm opacity-70 mt-1">{{ item.description }}</p>{% endif %}
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <span class="font-display font-bold text-primary whitespace-nowrap">{{ item.price }} {{ block.currency }}</span>
            <button type="button" class="btn btn-primary btn-sm btn-circle text-lg" data-a2ui-add data-name="{{ item.name }}" data-price="{{ item.price }}" aria-label="Добавить {{ item.name }}">+</button>
          </div>
        </li>
        {% endfor %}
      </ul>
      <label class="form-control w-full">
        <div class="label"><span class="label-text font-medium">Телефон для подтверждения</span></div>
        <input type="tel" data-a2ui-id="phone_number" data-required="true" placeholder="+7 900 000-00-00" class="input input-bordered w-full">
      </label>
      <div class="flex items-center justify-between text-sm">
        <span class="opacity-70">Итого:</span>
        <span class="font-display font-bold text-lg" data-cart-total>0 {{ block.currency }}</span>
      </div>
      <button type="button" data-a2ui-action="submit" data-endpoint="{{ block.target_endpoint }}" class="btn btn-primary btn-block">Оформить заказ</button>
      <div data-a2ui-status class="text-sm text-center opacity-70" aria-live="polite"></div>
    </div>
  </div>
</section>