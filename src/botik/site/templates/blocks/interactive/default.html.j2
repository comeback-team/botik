<section id="s{{ idx }}" class="py-14 md:py-20 px-4 bg-base-200">
  <div class="max-w-xl mx-auto card bg-base-100 shadow-xl w-full">
    <div class="card-body gap-4" data-a2ui-block data-submit-action="{{ block.submit_action }}">
      <h2 class="card-title text-2xl md:text-3xl [overflow-wrap:anywhere]">{{ block.title }}</h2>
      {% for comp in block.components %}
      {% if comp.type.value == "text_input" %}
      <label class="form-control w-full">
        <div class="label"><span class="label-text font-medium">{{ comp.label }}{% if comp.required %} <span class="text-error">*</span>{% endif %}</span></div>
        <input type="text" data-a2ui-id="{{ comp.id }}" data-required="{{ comp.required | lower }}" placeholder="{{ comp.placeholder }}" class="input input-bordered w-full">
      </label>
      {% elif comp.type.value == "number_stepper" %}
      <div class="form-control w-full">
        <div class="label"><span class="label-text font-medium">{{ comp.label }}</span></div>
        <div class="join w-full">
          <button type="button" class="btn join-item" data-stepper="dec" data-target="{{ comp.id }}">−</button>
          <input type="number" data-a2ui-id="{{ comp.id }}" value="{{ comp.initial_value }}" min="{{ comp.min }}" max="{{ comp.max }}" step="{{ comp.step }}" class="input input-bordered join-item flex-1 min-w-0 text-center">
          <button type="button" class="btn join-item" data-stepper="inc" data-target="{{ comp.id }}">+</button>
        </div>
      </div>
      {% elif comp.type.value == "select_options" %}
      <label class="form-control w-full">
        <div class="label"><span class="label-text font-medium">{{ comp.label }}</span></div>
        <select data-a2ui-id="{{ comp.id }}" class="select select-bordered w-full">
          {% for opt in comp.options %}<option>{{ opt }}</option>{% endfor %}
        </select>
      </label>
      {% elif comp.type.value == "action_button" %}
      <button type="button" data-a2ui-action="{{ comp.action_type.value }}" data-endpoint="{{ comp.target_endpoint }}" class="btn {{ 'btn-primary' if comp.action_type.value == 'submit' else 'btn-outline' }} btn-block mt-2 whitespace-normal h-auto py-3">{{ comp.label }}</button>
      {% endif %}
      {% endfor %}
      <div data-a2ui-status class="text-sm text-center opacity-70" aria-live="polite"></div>
    </div>
  </div>
</section>