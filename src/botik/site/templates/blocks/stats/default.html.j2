<section id="s{{ idx }}" class="py-12 md:py-16 px-4">
  <div class="max-w-6xl mx-auto min-w-0">
    {% if block.title %}<h2 class="text-2xl md:text-3xl font-bold text-center mb-8 break-words">{{ block.title }}</h2>{% endif %}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {% for item in block.items %}
      <div class="card bg-base-200"><div class="card-body items-center text-center p-6">
        <div class="text-3xl md:text-5xl font-extrabold text-primary break-words">{{ item.value }}</div>
        <div class="text-sm opacity-70 mt-1 break-words">{{ item.label }}</div>
      </div></div>
      {% endfor %}
    </div>
  </div>
</section>