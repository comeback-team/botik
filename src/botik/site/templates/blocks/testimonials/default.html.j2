<section id="s{{ idx }}" class="py-14 md:py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display text-2xl md:text-4xl font-bold text-center mb-10">{{ block.title }}</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {% for item in block.items %}
      <div class="card bg-base-200">
        <div class="card-body gap-3">
          <div class="text-secondary text-lg tracking-widest" aria-label="Оценка {{ item.rating }} из 5">{{ "★" * item.rating }}{{ "☆" * (5 - item.rating) }}</div>
          <p class="text-sm md:text-base leading-relaxed opacity-90">«{{ item.text }}»</p>
          <div class="flex items-center gap-3 mt-auto pt-2">
            <div class="w-10 h-10 rounded-full bg-primary text-primary-content font-display font-bold flex items-center justify-center">{{ item.author[:1] }}</div>
            <div><p class="font-semibold text-sm">{{ item.author }}</p>{% if item.role %}<p class="text-xs opacity-60">{{ item.role }}</p>{% endif %}</div>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>