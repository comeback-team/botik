<section id="s{{ idx }}" class="py-14 md:py-20 px-4">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl md:text-4xl font-bold mb-6 [overflow-wrap:anywhere]">{{ block.title }}</h2>
    <p class="text-base md:text-lg leading-relaxed opacity-80 whitespace-pre-line [overflow-wrap:anywhere]">{{ block.content }}</p>
  </div>
</section>